namespace RollPlugin
{
    public interface ICommand
    {
        string Name { get; }

        void Execute(IPlayer sender, string[] args);
    }
    public interface IPlayer
    {
        string Name { get; }

        void SendMessage(string message);

        void BroadcastMessage(string message);
    }
    public class RollCommand : ICommand
    {
        private readonly Random _random = new Random();

        public string Name
        {
            get
            {
                return "roll";
            }
        }

        public void Execute(IPlayer sender, string[] args)
        {
            int num = _random.Next(1, 7);
            string message = string.Format("{0} бросает кости и выпадает {1}!", sender.Name, num);
            sender.BroadcastMessage(message);
        }
    }
    public static class PluginEntry
    {
        public static void OnLoad(IServer server)
        {
            server.RegisterCommand(new RollCommand());
        }
    }
    public interface IServer
    {
        void RegisterCommand(ICommand command);
    }
}